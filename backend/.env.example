# Copie para .env (na pasta backend) e preencha.
# Senha da página que lista todos os tenants. Vazia: a página não abre.
LIST_TENANT_PAGE_PASSWORD=

# DB
DATABASE_URL=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Testes de integração (./gradlew integrationTest), banco synergia_test.
# TEST_DB_URL tem padrão (localhost:5432/synergia_test); usuário e senha, não.
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# Testes de sistema (perfil e2e, Cypress), banco synergia_e2e.
E2E_DB_USERNAME=
E2E_DB_PASSWORD=