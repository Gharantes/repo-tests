{
  "name": "synergia-testes-seguranca",
  "private": true,
  "description": "Testes de segurança (IDOR, criptografia/senhas, injeção, bots) contra o backend do Synergia rodando.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"security/*.test.mjs\"",
    "test:idor": "node --test security/01-idor.test.mjs",
    "test:senhas": "node --test security/02-criptografia-senhas.test.mjs",
    "test:injecao": "node --test security/03-injecao.test.mjs",
    "test:bots": "node --test security/04-bots.test.mjs",
    "test:ci": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=relatorio-seguranca.xml \"security/*.test.mjs\""
  },
  "dependencies": {
    "pg": "8.13.1"
  }
}
